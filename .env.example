# Copier vers .env (jamais commite) et renseigner ce dont tu as besoin.

# --- Trackers Torznab ---
# Passkeys de tes trackers, interpolees dans config.yaml via ${...}.
# Renomme/ajoute autant de variables que de trackers.
TRACKER1_API_KEY=
TRACKER2_API_KEY=

# --- Authentification (optionnelle) ---
# Renseigner les deux pour activer la connexion ; ce compte devient l'administrateur.
# Laisser vide pour un acces libre (ex. en local ou derriere un VPN).
TORSEARCH_USERNAME=
TORSEARCH_PASSWORD=
# Cle de signature des sessions (sinon generee dans data/.session_secret).
TORSEARCH_SECRET_KEY=
# Mettre a 1 si TorrSearch est servi derriere un reverse proxy HTTPS (cookie Secure).
TORSEARCH_HTTPS=
# Derriere un reverse proxy : IP EXACTE du proxy, autorise a transmettre l'IP reelle des
# clients (X-Forwarded-For). Sans ca, l'anti-brute-force voit l'IP du proxy pour tout le
# monde. Evite les plages larges et * : un client qui se connecte directement (ex. via la
# passerelle Docker) pourrait alors usurper son IP. Si le proxy tourne sur la meme machine,
# publie le port en local seulement ("127.0.0.1:8080:8000" dans docker-compose.yml).
# FORWARDED_ALLOW_IPS=172.18.0.2

# --- Decouverte TMDB (optionnelle) ---
# Cle API gratuite : https://www.themoviedb.org/ (Parametres > API).
# Se regle aussi dans Reglages > Decouverte (TMDB) ; la cle saisie la-bas est prioritaire.
TMDB_API_KEY=
